rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Max 5 MB; images and PDFs only
    function validUpload() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('(image/.*|application/pdf)');
    }

    // ── User profile photos ──────────────────────────────────────────────────

    match /users/{userId}/profile/{fileName} {
      allow read:  if true;
      allow write: if signedIn() && request.auth.uid == userId && validUpload();
    }

    // ── Artisan verification documents (NIN, ID, work photos) ────────────────

    match /artisans/{userId}/verification/{fileName} {
      allow read:  if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if signedIn() && request.auth.uid == userId && validUpload();
    }

    match /artisans/{userId}/work-photos/{fileName} {
      allow read:  if true;
      allow write: if signedIn() && request.auth.uid == userId && validUpload();
    }

    // ── Job photos (uploaded by client) ──────────────────────────────────────

    match /jobs/{jobId}/{fileName} {
      allow read: if signedIn() && (
        firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid
      );
      allow write: if signedIn() &&
        firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.clientId == request.auth.uid &&
        validUpload();
    }

    // ── Proforma invoices (uploaded by artisan) ───────────────────────────────

    match /proformas/{jobId}/{fileName} {
      allow read: if isAdmin() ||
        (signedIn() && (
          firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
          firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid
        ));
      allow write: if signedIn() &&
        firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid &&
        validUpload();
    }
  }
}
