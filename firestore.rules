rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isJobParticipant(jobData) {
      return signedIn() &&
        (jobData.clientId == request.auth.uid || jobData.artisanId == request.auth.uid);
    }

    // ── users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow create: if owns(userId) && request.resource.data.role in ['client', 'artisan'];
      allow read:   if owns(userId) || isAdmin();
      allow update: if (owns(userId) &&
        request.resource.data.role in ['client', 'artisan'] &&
        request.resource.data.diff(resource.data).unchangedKeys().hasAll(['uid', 'createdAt']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── privateArtisans ───────────────────────────────────────────────────────

    match /privateArtisans/{userId} {
      allow create: if owns(userId) && request.resource.data.uid == request.auth.uid;
      allow read:   if owns(userId) || isAdmin();
      allow update: if (owns(userId) &&
        request.resource.data.diff(resource.data)
          .unchangedKeys().hasAll(['uid', 'paystackRecipientCode', 'bankAccountNumber', 'bankCode', 'accountName', 'bankDetailsVerifiedAt']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── artisanProfiles ───────────────────────────────────────────────────────

    match /artisanProfiles/{userId} {
      allow read: if true;
      allow create: if owns(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.isVerified == false;
      // Artisan can update their own profile but cannot touch verification fields
      allow update: if (owns(userId) &&
        request.resource.data.diff(resource.data)
          .unchangedKeys().hasAll(['uid', 'isVerified', 'createdAt', 'no_response_flags', 'reputation_score', 'completed_jobs', 'priority_score', 'responseSpeedScore', 'verificationReason', 'verifiedAt']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── jobs ──────────────────────────────────────────────────────────────────

    match /jobs/{jobId} {
      allow create: if signedIn() &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.escrowStatus == 'unfunded' &&
        request.resource.data.artisanId == null;
      allow read:   if isAdmin() || isJobParticipant(resource.data);

      // Clients may edit job details. State, escrow, assignment, and ratings are
      // exclusively controlled by Cloud Functions.
      allow update: if isAdmin()
        || (signedIn() && resource.data.clientId == request.auth.uid &&
            resource.data.status == 'open' &&
            request.resource.data.diff(resource.data)
              .unchangedKeys().hasAll(['clientId', 'artisanId', 'matchId', 'status', 'escrowStatus', 'paymentReference', 'paymentInitializationReference', 'paymentInitializedAt', 'noResponseDeadline', 'rating', 'review', 'createdAt'])));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.clientId == request.auth.uid && resource.data.status == 'open');

      // ── messages (sub-collection) ──────────────────────────────────────────

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (signedIn() && (
            get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid
          ) && get(/databases/$(database)/documents/jobs/$(jobId)).data.status in ['accepted', 'in_progress', 'completed']);
        allow create: if signedIn() &&
          request.resource.data.senderUid == request.auth.uid &&
          (get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
           get(/databases/$(database)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid) &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.status in ['accepted', 'in_progress', 'completed'] &&
          request.resource.data.keys().hasAll(['senderUid', 'content', 'createdAt']) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 2000;
        allow update, delete: if false;
      }

      // ── tracking (sub-collection) ─────────────────────────────────────────

      match /tracking/{trackingId} {
        allow read: if isAdmin() ||
          (signedIn() && (
            get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid ||
            get(/databases/$(database)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid
          ));
        allow create, update: if signedIn() &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.artisanId == request.auth.uid;
        allow delete: if false;
      }
    }

    // ── proformas ─────────────────────────────────────────────────────────────

    match /proformas/{proformaId} {
      function relatedJob() {
        return get(/databases/$(database)/documents/jobs/$(resource.data.jobId));
      }

      allow read: if isAdmin() ||
        (signedIn() && (
          relatedJob().data.clientId == request.auth.uid ||
          relatedJob().data.artisanId == request.auth.uid
        ));
      allow create: if false; // Cloud Functions only
      allow update: if false; // Cloud Functions only
      allow delete: if false;
    }

    // ── payments ──────────────────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read:  if isAdmin() || (signedIn() &&
        (resource.data.clientId == request.auth.uid || resource.data.artisanId == request.auth.uid));
      allow write: if false; // Cloud Functions only
    }

    // ── ratings ───────────────────────────────────────────────────────────────

    match /ratings/{ratingId} {
      allow read: if isAdmin() ||
        (signedIn() && (
          resource.data.clientId == request.auth.uid ||
          resource.data.artisanId == request.auth.uid
        ));
      allow create: if false; // Cloud Functions only
      allow update, delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read:   if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false; // Cloud Functions only
      // User can only mark their own notifications as read
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ── analyticsEvents ───────────────────────────────────────────────────────

    match /analyticsEvents/{eventId} {
      allow read:  if isAdmin();
      allow write: if false; // Cloud Functions only
    }
  }
}
