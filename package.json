{
  "name": "artiva-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "backend:lint": "node --check functions/index.js",
    "backend:check": "node --check functions/index.js",
    "backend:emulators": "firebase emulators:start",
    "backend:emulators:export": "firebase emulators:start --import ./.firebase-data --export-on-exit ./.firebase-data",
    "backend:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "backend:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "backend:secret:set": "firebase functions:secrets:set PAYSTACK_SECRET_KEY",
    "backend:config:set": "firebase functions:config:set"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-phone-number-input": "^3.4.17"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^14.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
